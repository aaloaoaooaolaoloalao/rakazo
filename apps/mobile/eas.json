{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "node": "24.22.2",
      "pnpm": "12.18.0",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "node": "24.22.2",
      "pnpm": "12.18.0",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "android-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "environment": "production"
    },
    "diagnostic": {
      "extends": "production",
      "channel": "diagnostic"
    },
    "spark-preview": {
      "extends": "preview",
      "distribution": "internal",
      "environment": "spark-preview",
      "channel": "spark-preview",
      "node": "24.22.2",
      "pnpm": "12.18.0",
      "env": {
        "SPARK": "1",
        "EXPO_PUBLIC_SPARK": "1",
        "EXPO_PUBLIC_API_URL": "https://34-165-87-142.sslip.io"
      }
    },
    "spark-production": {
      "extends": "production",
      "environment": "spark-production",
      "channel": "spark-production",
      "node": "24.22.2",
      "pnpm": "12.18.0",
      "env": {
        "SPARK": "1",
        "EXPO_PUBLIC_SPARK": "1",
        "EXPO_PUBLIC_API_URL": "https://34-165-87-142.sslip.io"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
